# Set secrets in the server environment only. Blank tokens disable that staff role.
AOL_MANAGER_TOKEN=
AOL_REPORT_TOKEN=
AOL_DB_PATH=./data/aol-programs.sqlite
AOL_RETENTION_DAYS=90
AOL_POSTS_PER_MINUTE=120

# People & Journeys and SevaAssist. The manager token above also works here (and can delete).
# Give volunteers and teachers this token: they can use everything except deleting.
AOL_VOLUNTEER_TOKEN=
AOL_CARE_DB_PATH=./data/care.sqlite
# Time zone for "today" in the follow-up queue, and the country code added to 10-digit phone numbers.
AOL_TIME_ZONE=America/Edmonton
AOL_PHONE_COUNTRY_CODE=1

# Where the whole app listens. Use HOST=0.0.0.0 when hosting or testing from a phone.
HOST=127.0.0.1
PORT=3000

# Set the public site exact origin in production, without a trailing slash.
AOL_PUBLIC_ORIGIN=

# Optional team-approved HTTPS pages. Blank values use the official defaults.
AOL_FOLLOWUPS_URL=
AOL_VOLUNTEER_URL=
AOL_TEACHER_URL=
AOL_ONLINE_URL=

# Flyer Studio: operator token when hosted (blank = operator panel only from this computer).
ADMIN_TOKEN=
# Flyer Studio: optional AI-written invitation line.
ANTHROPIC_API_KEY=

# Outreach Finder: optional live events from Ticketmaster.
TICKETMASTER_KEY=
